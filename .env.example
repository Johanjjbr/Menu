# Copiar este archivo como .env.local y completar con los datos de
# Supabase → Project Settings → API (o "API Keys").
#
# Estas dos claves son públicas por diseño (la seguridad la dan las
# políticas RLS). NUNCA pongan acá la service_role / secret key.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Si el proyecto todavía usa la clave "anon" legacy (eyJhbGciOi...),
# pueden ponerla en esta variable en lugar de la de arriba:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Datos del restaurante que se muestran en /menu
NEXT_PUBLIC_RESTAURANT_NAME=Nuestro restaurante
NEXT_PUBLIC_RESTAURANT_TAGLINE=Cocina de todos los días
